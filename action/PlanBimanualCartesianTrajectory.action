# End-effectors facing: both tools face each other along the line that joins them.
# Left and right arms are fixed by the server configuration; only arm joints move.
# Axis of each tool (in its own frame) that points to the other one: +-x, +-y or +-z.
geometry_msgs/Vector3 left_pointing_axis
geometry_msgs/Vector3 right_pointing_axis
# Relative roll around the line left -> right [rad]; NaN keeps the measured roll.
# Zero reference axis per tool (cyclic, same sign): +-x -> +-y, +-y -> +-z, +-z -> +-x.
float64 roll_angle
# Distance between both tools [m].
float64 distance
# Tolerances along the whole path; zero remains strict. pointing_tolerance is the
# angle between each tool axis and its reference direction.
float64 pointing_tolerance
float64 roll_tolerance
float64 distance_tolerance
# Non-positive step/time select the configured defaults.
float64 cartesian_step
float64 planning_time
# false keeps the goal pending until execute_pending_trajectory is called.
bool execute
# Joint velocity/acceleration limit factors in (0, 1]; zero uses server defaults.
# These determine trajectory timing, not the planning computation budget.
float64 velocity_scaling
float64 acceleration_scaling
# Execution backend: controller, task or facing. Empty uses the server's execution_backend.
string execution_backend
# Facing execution only: validate with STPIK before streaming. Other backends ignore this.
bool use_stpik true
# Optimize the whole trajectory with the controller's Task Priority hierarchy (the same
# global planner as the single-arm robot_nominal mode) instead of the local per-waypoint
# solver. Requires the facing backend; the tracking tolerances are the server's
# execution.facing_*_tolerance and the timing follows velocity_scaling.
bool optimize_trajectory_nominal false
# Progress share in [0, 1) used to reach the pointing axes and the roll before the
# distance changes; 0 changes everything simultaneously. Negative uses the server's
# planning.facing_orientation_fraction.
float64 facing_orientation_fraction -1.0
---
bool success
string message
trajectory_msgs/JointTrajectory joint_trajectory
# Geometric progress in [0, 1] of each joint_trajectory point.
float64[] nominal_progress
# Facing reference as a function of progress (no timing).
FacingPath facing_path
# Tool paths reached by forward kinematics, in relative_reference_frame (zero stamp).
nav_msgs/Path left_path
nav_msgs/Path right_path
---
float32 progress
string current_stage
string message
