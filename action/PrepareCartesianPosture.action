uint8 PLAN=0
uint8 APPLY=1
uint8 operation
uint64 preparation_id
CartesianPoseTrajectory trajectory
string task_id
string tip_frame
geometry_msgs/Quaternion tolerance_orientation
float64[6] path_tolerance
float64[6] goal_tolerance
float64 goal_time_tolerance
# Frozen MoveIt scene, in the planning frame. APPLY provides a fresh scene.
moveit_msgs/PlanningScene scene
string robot_description
string robot_description_semantic
# Whole-body nominal trajectory (base + both arms) for robot_nominal. PLAN optimizes the
# initial posture as its first knot (no separate posture search); APPLY repositions,
# then replans the nominal from the settled state.
bool full_trajectory false
# End-effectors facing (non-empty points, implies full_trajectory): task_id is the
# EndEffectorsFacingTask and path/goal tolerances follow its rows [left pointing(2),
# right pointing(2), roll, distance]. The path is timed by the rest-to-rest quintic
# progress over facing_duration and starts at the measured posture (PLAN only).
# nominal_activation masks robot_nominal; false base rows keep the base where it is.
# trajectory, tip_frame and tolerance_orientation are ignored.
FacingPath facing_path
float64 facing_duration
bool[] nominal_activation
# Facing planning only simulates the facing hierarchy, whatever the controller has enabled:
# task_id and robot_nominal are assumed enabled, robot_nominal below task_id, and these
# tasks disabled. The running controller is not modified.
string[] facing_disabled_tasks
---
bool success
string message
PosturePreparationSummary proposal
# Filled only with full_trajectory. Both share time_from_start and use the controller
# world frame; the joint trajectory contains both arms in controller order.
trajectory_msgs/JointTrajectory nominal_joints
trajectory_msgs/MultiDOFJointTrajectory nominal_base
# Geometric Cartesian path fraction at each nominal knot.
float64[] nominal_progress
string nominal_method
float64 nominal_cost
---
string stage
uint32 evaluations
