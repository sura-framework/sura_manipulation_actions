# Read-only offline check. No motion commands are published by this action.
CartesianPoseTrajectory trajectory
string task_id
string tip_frame
geometry_msgs/Quaternion tolerance_orientation
# Exact Cartesian tracking tolerances supplied by the planning goal; no host error cap.
float64[6] path_tolerance
float64[6] goal_tolerance
float64 goal_time_tolerance
# Zero runs a simulation; nonzero revalidates a previous successful snapshot.
uint64 validation_id
# Optional sampled trajectory. When non-empty it replaces the rest-to-rest profile in
# `trajectory`; the reference frame is still trajectory.header.frame_id.
CartesianPoseSample[] samples
# Optional whole-body nominal (base + both arms) streamed to the robot_nominal task
# during the simulation, exactly as the Pose executor streams it at runtime.
trajectory_msgs/JointTrajectory nominal_joints
trajectory_msgs/MultiDOFJointTrajectory nominal_base
LocalPrediction prediction
# Non-empty points select the facing check: task_id is an EndEffectorsFacingTask,
# nominal_joints/nominal_base are streamed to robot_nominal with nominal_activation (as the
# facing executor does) and nominal_progress gives the progress of each of their points.
# path/goal tolerances then follow the facing rows [left pointing(2), right pointing(2),
# roll, distance]; trajectory, samples, tip_frame and tolerance_orientation are ignored.
FacingPath facing_path
float64[] nominal_progress
bool[] nominal_activation
---
uint8 SUCCESS=0
uint8 FAIL=1
uint8 UNAVAILABLE=2
uint8 CANCELED=3
uint8 outcome
string code
string message
float64 time_from_start
string[] joint_names
float64[] joint_positions
geometry_msgs/Pose base_pose
float64[6] tracking_error
string task_id
# A stall identifies position, orientation or position_and_orientation here;
# message contains the demand, achieved movement and error reduction for each group.
string constraint
float64 minimum_clearance
float64 maximum_velocity_ratio
float64 minimum_singular_value
uint64 validation_id
LocalSegment segment
float64 continuation_cost
float64 segment_cost
float64 configuration_error
uint32 hierarchy_rank
string[] active_constraints
uint32 candidates
PredictionSample[] trace
LocalCandidatePath[] explored_paths
float64 compute_seconds
---

float32 progress
float64 time_from_start
string message
